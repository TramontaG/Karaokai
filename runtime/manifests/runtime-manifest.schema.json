{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KaraokAI Runtime Manifest",
  "type": "object",
  "required": ["version", "releaseTag", "assets"],
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "releaseTag": { "type": "string" },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "asset",
          "sha256",
          "size",
          "platform",
          "architecture",
          "format",
          "installDirectory"
        ],
        "properties": {
          "id": {
            "enum": ["ffmpeg", "ml-worker", "demucs-htdemucs"]
          },
          "version": { "type": "string" },
          "asset": { "type": "string" },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "size": { "type": "integer", "minimum": 1 },
          "platform": { "enum": ["linux", "windows", "macos", "any"] },
          "architecture": { "enum": ["x86_64", "aarch64", "any"] },
          "format": { "const": "zip" },
          "installDirectory": { "type": "string" }
        }
      }
    }
  }
}
