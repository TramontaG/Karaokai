{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KaraokAI",
  "version": "0.1.0",
  "identifier": "com.karaokai.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "KaraokAI",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../worker/pyproject.toml": "worker/pyproject.toml",
      "../worker/karaoke_worker": "worker/karaoke_worker"
    }
  }
}
